{
  "name": "Alcovia (TEMPLATE) | Invoice due detection and queue",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.alert_outbox(alert_key,event_type,object_key,title,due_at) SELECT 'invoice:'||invoice_id||':'||due_at::date,'invoice-due',invoice_id,'Check unpaid invoice '||invoice_id,due_at FROM ops.invoices WHERE status IN ('issued','part_paid') AND due_at < now() ON CONFLICT(alert_key) DO NOTHING RETURNING alert_key,object_key,title;",
        "options": {}
      },
      "id": "pg-upsert",
      "name": "Idempotently queue alerts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json:{alert_key:item.json.alert_key,queued:true,object_key:item.json.object_key}}));"
      },
      "id": "report",
      "name": "Return queued IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        240
      ]
    }
  ],
  "connections": {
    "Daily 9am": {
      "main": [
        [
          {
            "node": "Idempotently queue alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idempotently queue alerts": {
      "main": [
        [
          {
            "node": "Return queued IDs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}